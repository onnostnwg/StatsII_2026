AIC(m2, m2_galtan, m2_selected)
stargazer(
m2, m2_galtan, m2_selected,
type = "latex",
column.labels = c("M2", "M2 + GAL-TAN", "Selected Model"),
dep.var.labels = "Susceptibility to populism"
)

## make our table a bit more beautiful and easier to handle
rownames(obs) <- c("Upper Class", "Lower Class")
colnames(obs) <- c("NotStopped", "Bribe", "Stopped")
obs
row_totals <- rowSums(obs)
col_totals <- colSums(obs)
grand_total <- sum(obs)
row_totals
col_totals
grand_total
expected <- outer(row_totals, col_totals) / grand_total
chi_components <- (obs - expected)^2 / expected
chi_components
chi_sq <- sum(chi_components)
chi_sq
#### df=(r−1)(c−1)=(2−1)(3−1)=2

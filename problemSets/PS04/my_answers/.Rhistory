rm(list=ls())
# Define the data
X <- c(5, 7, 4, 15, 12, 9, 11, 13)
Y <- c(8, 9, 12, 26, 16, 13, 15, 18)
# Fit the linear model
model <- lm(Y ~ X)
# View the results
summary(model)
Temp <- c(12, 15, 19, 20, 22, 22, 14, 15, 16, 25)
Sales <- c(70, 80, 110, 178, 119, 65, 90, 44, 90, 300)
# Fit the linear model
model <- lm(Sales ~ Temp)
# Calculate Cook's distance
cooks_d <- cooks.distance(model)
# View Cook's distances
cooks_d
# Identify observations with large Cook's distance
cooks_d > (4 / length(Temp))
# Plot Cook's distance
plot(cooks_d, type = "h",
ylab = "Cook's Distance",
xlab = "Observation")
abline(h = 4 / length(Temp), col = "red", lty = 2)
mark <- c(55, 58, 60, 65, 70, 22, 74, 77)
hours <- c(2, 2.5, 3, 3.5, 4, 5, 6, 7)
# Basic scatter plot
plot(hours, mark,
pch = 19,          # solid dots
col = "blue",
xlab = "Hours of Study",
ylab = "Exam Marks",
main = "Scatter Plot of Exam Marks vs. Study Hours")
# Optional: add a simple linear regression line
model <- lm(mark ~ hours)
abline(model, col = "red", lwd = 2)
